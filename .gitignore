# Credenciales y configuración local — nunca se sube
.env
.env.*

# Catálogo real de productos (usa catalogo-data-base/catalog.example.json como referencia)
catalogo-data-base/*
!catalogo-data-base/.gitkeep
!catalogo-data-base/catalog.example.json

# Menús y reportes reales de clientes — información comercial privada
menus/*
!menus/.gitkeep
data-json/*
!data-json/.gitkeep
reports/*
!reports/.gitkeep
reportsDocx/*
!reportsDocx/.gitkeep

# Datos de los Módulos 2 y 3 (visitas, exports) — información comercial privada
visitas/*
!visitas/.gitkeep
exports/*
!exports/.gitkeep
citas/*
!citas/.gitkeep
notas/*
!notas/.gitkeep
clientes/*
!clientes/.gitkeep
cobros/*
!cobros/.gitkeep
entrantes/*
!entrantes/.gitkeep

# Memoria acumulada de Engram (conocimiento comercial, no código)
*.db
.engram/

# Sandboxes temporales del smoke test (guardia ante crashes)
/.smoke-test.*/
# Local AI runtime state
.atl/

# Reportes del agente e info comercial del vendedor
AGENTE_REPORTE.md
*.xlsx

# Packaging plan (mobile independence, not part of core CRM)
PACKAGING_PLAN.md

# SO / editores
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.vscode/
.idea/
*.swp
*.swo
